include LICENSE
include MANIFEST.in
include pimms/*.pyx


# `graft pimms` sweeps the FILESYSTEM, not the git index, so anything sitting
# untracked in a working tree (stale in-place build outputs, Cython annotation
# HTMLs, pytest caches, benchmark logs) would otherwise ship to PyPI - the 1.0.6
# sdist/wheel carried 3.5 MB of .o files from a 2021 Python 3.8 build this way.
# The prunes/excludes below keep the graft to actual source + test fixtures.
graft pimms
prune pimms/build
prune pimms/.pytest_cache
# pimms/cython_backup no longer exists in the repository. The prune stays on purpose
# (and is pinned by test_no_cython_backup_in_distribution): it held stale pre-fix
# copies of the kernels, and this stops a copy re-created in a working tree from
# shipping. setuptools reports "no previously-included directories found" for it,
# which is expected.
prune pimms/cython_backup
global-exclude *.html

# The Cython-generated C is a build product, not source, and must not ship. setup.py
# runs `cythonize` every time it is imported, which writes pimms/*.c next to each
# .pyx and makes those .c files the extensions' sources, so without this line both
# the sdist and the wheel carried them (ten files, 16 MB of a 23 MB wheel). In an
# sdist they are worse than dead weight: Cython reuses a .c that is newer than its
# .pyx, so which C got compiled depended on file timestamps in the build
# environment, and C generated for one Cython/Python pair does not always compile
# on a later one. Leaving them out is safe because Cython is a declared build
# requirement (pyproject.toml) and setup.py cannot run without it, so an install
# from the sdist always regenerates the C from the .pyx files it does ship.
global-exclude *.c

# Simulation regression tests deliberately run inside their fixture directories.
# Because `graft pimms` scans the working tree rather than the git index, every
# ignored run output created by a local test run would otherwise be swept into the
# next sdist/wheel (hundreds of tables plus PDB/XTC/restart files). Keep only the
# tracked inputs and expected-output summaries.
global-exclude *.dat *.xtc *.pdb *.log log.txt restart.pimms parameters_used.prm keyfile_used.kf
global-exclude absolute_energies_of_angles.txt pytest_test_*_log.txt
global-exclude *.py[cod] __pycache__ *.so *.o .gitignore .DS_Store

# pimms/data/look_and_say.dat is a placeholder from the cookiecutter template -
# nothing in PIMMS reads it (see pimms/data/README.md) - but it is tracked and is
# the one .dat file the package ships on purpose, so re-add it after the global
# simulation-output exclusion above.
include pimms/data/look_and_say.dat
