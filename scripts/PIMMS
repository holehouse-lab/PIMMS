import sys
import argparse 
import os

import pimms

# A stale `pimms/` directory on sys.path (typically left behind in site-packages
# by an old non-editable install) is imported by Python as an __init__-less
# NAMESPACE package that shadows the real one: submodules still resolve through
# an editable install, but `pimms.__version__` (and anything else defined in
# pimms/__init__.py) is missing. Diagnose that explicitly instead of dying
# with an AttributeError deep in the version print.
if getattr(pimms, '__file__', None) is None:
    sys.stderr.write(
        "ERROR: 'pimms' was imported as a namespace package (no __init__.py) from:\n"
        + "".join("    %s\n" % p for p in getattr(pimms, '__path__', []))
        + "This is a stale directory shadowing the installed PIMMS package - remove it "
          "(or reinstall PIMMS) and try again.\n")
    sys.exit(1)

from pimms import IO_utils, CONFIG


def pimms_version():
    """
    Return the installed PIMMS version string.

    Prefers ``pimms.__version__``; falls back to the distribution metadata so the
    command still answers if the package attribute is ever unavailable.

    Returns
    -------
    str
        The version string, or 'unknown' if neither the package attribute nor
        the distribution metadata could be read.

    """
    version = getattr(pimms, '__version__', None)
    if version:
        return version
    try:
        from importlib.metadata import version as _dist_version
        return _dist_version('idptools-pimms')
    except Exception:
        return 'unknown'

def print_startup():
    """
    Print the PIMMS banner and version to standard output.

    Returns
    -------
    None
        No return value; the banner is printed to standard output.

    """
    IO_utils.status_message('','major')
    print("+-------------------------------------------------+")
    print("|                                                 |")
    print("|                      PIMMS                      |")
    print("|                                                 |")
    print("| Polymer Interactions in Multicomponent Mixtures |")
    print("|                                                 |")
    print("+-------------------------------------------------+")
    print("         Version [%s]" % (pimms_version()))
    print("")
    IO_utils.status_message('STARTING PIMMS...','major')

def print_info_header():
    """
    Print the banner plus the explanatory preamble used by the --info flag.

    Returns
    -------
    None
        No return value; the header is printed to standard output.

    """
    print_startup()

    IO_utils.stdout('[-i/--info] flag prints out information on every keyword that a PIMMS simulation can use. Keywords are grouped by purpose; run PIMMS --info <keyword> for the details of one keyword, or PIMMS --info ALL to print them all. \n', 60)


def grouped_keywords():
    """
    Group the documented keyfile keywords into the headings used by --info.

    Groups are taken from ``CONFIG.KEYWORD_GROUPS``, in the order defined there,
    and only keywords that actually appear in ``CONFIG.KEYWORDS_DESCRIPTION`` are
    included. Any documented keyword not assigned to a group is collected under a
    trailing 'Other' heading so nothing is ever dropped.

    Returns
    -------
    list of tuple
        A list of ``(heading, keywords)`` pairs, where heading is a str and
        keywords is a list of keyword-name strings.

    """
    groups = []
    seen = set()
    for heading, keys in CONFIG.KEYWORD_GROUPS:
        present = [k for k in keys if k in CONFIG.KEYWORDS_DESCRIPTION]
        if present:
            groups.append((heading, present))
            seen.update(present)
    leftover = [k for k in CONFIG.KEYWORDS_DESCRIPTION if k not in seen]
    if leftover:
        groups.append(("Other", leftover))
    return groups


# because we want this to be a stand alone program we need to include all
# the argparse stuff inside a __main__ guard
if __name__=="__main__":

    # We create a argument parser (called 'parser') here 
    # Basically what this does is create an ArgumentParser object
    parser = argparse.ArgumentParser(
        description="Run a PIMMS lattice Monte Carlo simulation defined by a keyfile, or look up\n"
                    "the keyfile keywords. A simulation writes all of its output files into the\n"
                    "current working directory.",
        epilog="examples:\n"
               "  PIMMS -k KEYFILE.kf        run the simulation defined in KEYFILE.kf\n"
               "  PIMMS --info               list every keyfile keyword, grouped by purpose\n"
               "  PIMMS --info TEMPERATURE   type, description and default of one keyword\n"
               "  PIMMS --info ALL           print every keyword description",
        formatter_class=argparse.RawDescriptionHelpFormatter)

    # We add the command line argument(s) we expected to parse
    # I've only defined one here, but we can add as many as we want.
    #
    #
    # --file is the long name which the program uses
    # -f is the short name
    # help describes what this argument does

    parser.add_argument("-keyfile", "-k", metavar="KEYFILE",
                        help="Path to the keyfile defining the simulation to run")
    parser.add_argument("--info", "-i", nargs='?', const='LIST', metavar="KEYWORD",
                        help="With no value, list every keyfile keyword grouped by purpose; with a "
                             "keyword name (case-insensitive), print its type, description and "
                             "default; with ALL, print every keyword in full")
    parser.add_argument("--version", "-v", action='store_true',
                        help="Print the installed PIMMS version")

    # having defined our argument variables we now parse the arguments parsed
    # to the program
    args = parser.parse_args()


    # if args has a variable called keyfile (which will happen if we passed
    # our program an argument associated with the -k or -keyfile flag
    if args.version:
        print('version %s' % (pimms_version()))
        
    elif args.info is not None:
        print_info_header()
        
        multiline_leader='          '
        
        # keyfile keywords are case-insensitive, so the lookup is too
        if args.info.upper() in CONFIG.KEYWORDS_DESCRIPTION:
            k = args.info.upper()
            k_type    = CONFIG.KEYWORDS_DESCRIPTION[k][0]
            k_desc    = CONFIG.KEYWORDS_DESCRIPTION[k][1]

            # the same readable form the keyword reference uses: derived defaults
            # are named, and internal 'not set' placeholders are not printed raw
            k_default = CONFIG.display_default(k) or 'none (required)'

            IO_utils.stdout(f'NAME    : {k}', multiline_leader=multiline_leader)
            IO_utils.stdout(f'TYPE    : {k_type}', multiline_leader=multiline_leader)
            IO_utils.stdout(f'DESCR   : {k_desc}', multiline_leader=multiline_leader)
            IO_utils.stdout(f'DEFAULT : {k_default}', multiline_leader=multiline_leader)
            IO_utils.newline()
        elif args.info.upper() == 'ALL':
            for heading, present in grouped_keywords():
                IO_utils.newline()
                print('===== %s =====' % heading)
                IO_utils.newline()
                for k in present:
                    k_type = CONFIG.KEYWORDS_DESCRIPTION[k][0]
                    k_desc = CONFIG.KEYWORDS_DESCRIPTION[k][1]

                    k_default = CONFIG.display_default(k) or 'none (required)'

                    IO_utils.stdout('NAME:     %s' % (k), multiline_leader=multiline_leader)
                    IO_utils.stdout('TYPE:     %s' % (k_type), multiline_leader=multiline_leader)
                    IO_utils.stdout('DESC:     %s' % (k_desc), multiline_leader=multiline_leader)
                    IO_utils.stdout('DEFAULT : %s' % (k_default), multiline_leader=multiline_leader)
                    IO_utils.newline()
        elif args.info.upper() == 'LIST':
            IO_utils.stdout('Keywords are grouped by purpose below. Required keywords: DIMENSIONS, PARAMETER_FILE, TEMPERATURE, N_STEPS, EQUILIBRATION, and CHAIN unless a RESTART_FILE supplies the chains.')
            print('')
            for heading, present in grouped_keywords():
                print(heading)
                print('-' * len(heading))
                IO_utils.stdout('  '.join(present), multiline_leader='  ')
                print('')
            
                
            
        else:
            print(f"Unknown keyword '{args.info}'. Run 'PIMMS --info' to list every valid keyword, "
                  f"'PIMMS --info <keyword>' for details on one, or 'PIMMS --info ALL' to print them all.")
            sys.exit(1)
    
        
    elif args.keyfile is not None:

        # Simulation startup pulls in NumPy, SciPy, MDTraj and all compiled
        # kernels.  Keep those imports on the execution path so inexpensive
        # informational commands such as ``--help`` and ``--version`` do not
        # pay that cost (or require the native extensions to be importable).
        from pimms.simulation import Simulation
        from pimms.keyfile_parser import KeyFileParser

        # print the standard startup message!
        print_startup()

        if not os.path.isfile(args.keyfile):
            IO_utils.status_message('Could not open file "%s". Exiting...\n' %(args.keyfile), msg_type='error')
            sys.exit(1)
            
        # read in the keyfile
        KeyFile = KeyFileParser(args.keyfile)

        # print a summary
        KeyFile.print_summary()
        
        # Set up a new simulation
        Simulator = Simulation(KeyFile.keyword_lookup)

        # Run a new simulation
        Simulator.run_simulation()

    else:
        print('No keyfile given - run PIMMS -k <keyfile> to start a simulation (try --help for more info)')

