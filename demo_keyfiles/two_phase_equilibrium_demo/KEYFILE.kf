## ..........................................................................................
# Input definition stuff 

DIMENSIONS : 30 30 30             # Cube dimensions
PARAMETER_FILE : params.prm       # parameter file

## ...........................................................................................
## chain definitions
#
# Have the format 
#
# CHAIN : <NUMBER OF CHAINS> <CHAIN SEQUENCE>
#
# All beads defined in the chain sequence must be defined in the PARAMETER_FILE

CHAIN : 200 AAAAA
CHAIN : 200 BBBBB
CHAIN : 200 CCCCC
CHAIN : 200 DDDD


#...........................................................................................
## Simulation definition

N_STEPS       :  200            # Number of simulation steps
EQUILIBRATION :    50            # Number of steps for equilibration
TEMPERATURE   :  60              # Simulation temperature
HARDWALL : True                  # Set so visualization is easy
PARALLELIZE : True
PARALLEL_THREADS : 0

#...........................................................................................
## Output information

PRINT_FREQ    :	 5              # Frequency at which info is printed to stdout
XTC_FREQ      :  10              # Frequency at which traj.xtc file is written to


#...........................................................................................
## Moveset keywords. Note moveset keywords (MOVE_*) must add up to 1.0
## 

CRANKSHAFT_SUBSTEPS: 20000        # number of substeps in the crankshat moves
PULL_substeps : 200
SLITHER_SUBSTEPS : 200
MOVE_CRANKSHAFT: 0            # Fraction of moves = crankshaft
MOVE_SLITHER : 1
MOVE_PULL : 0.
MOVE_VMMC : 0.0
MOVE_MULTICHAIN_TSMMC : 0.0

EXPERIMENTAL_FEATURES : True



