## ..........................................................................................
# Input definition stuff 

DIMENSIONS : 300 300             # Cube dimensions
PARAMETER_FILE : params.prm       # parameter file

## ...........................................................................................
## chain definitions
#
# Have the format 
#
# CHAIN : <NUMBER OF CHAINS> <CHAIN SEQUENCE>
#
# All beads defined in the chain sequence must be defined in the PARAMETER_FILE

CHAIN : 2000 AAAAAAAAA


#...........................................................................................
## Simulation definition

N_STEPS       :  10000            # Number of simulation steps
EQUILIBRATION :    50            # Number of steps for equilibration
TEMPERATURE   :  20              # Simulation temperature
HARDWALL : True                  # Set so visualization is easy
PARALLELIZE : False
EXPERIMENTAL_FEATURES : TRUE

#...........................................................................................
## Output information

PRINT_FREQ    :	 1000              # Frequency at which info is printed to stdout
XTC_FREQ      :  50              # Frequency at which traj.xtc file is written to



#...........................................................................................
## Moveset keywords. Note moveset keywords (MOVE_*) must add up to 1.0
## 

CRANKSHAFT_SUBSTEPS: 2000        # number of substeps in the crankshat moves
MOVE_CRANKSHAFT: 0.4             # Fraction of moves = crankshaft
MOVE_PULL : 0.3
PULL_SUBSTEPS : 50
MOVE_SLITHER : 0.3
SLITHER_SUBSTEPS : 200
MOVE_CHAIN_TRANSLATE : 0.0       # Fraction of moves that are chain translation
MOVE_CHAIN_ROTATE : 0.0          # Fraction of moves that are chain rotation
MOVE_CHAIN_PIVOT : 0.0           # Fraction of moves that are chain pivot
MOVE_HEAD_PIVOT : 0.0            # Fraction of moves that are head pivot (N/C terminal beads pivot)
MOVE_CLUSTER_TRANSLATE : 0.     # Fraction of moves that are cluster translation moves
MOVE_CLUSTER_ROTATE : 0.0        # Fraction of moves that are cluster rotation moves




