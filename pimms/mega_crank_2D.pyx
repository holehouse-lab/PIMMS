# 
def mega_crank_2D(NUMPY_INT_TYPE[:,:] grid, 
                  NUMPY_INT_TYPE[:,:] type_grid,                   
                  NUMPY_INT_TYPE_long[:,:] idx_to_bead,
                  NUMPY_INT_TYPE[:,:] interaction_table, 
                  NUMPY_INT_TYPE[:,:] LR_interaction_table, 
                  NUMPY_INT_TYPE[:,:] SLR_interaction_table, 
                  NUMPY_INT_TYPE[:,:,:,:,:]  angle_lookup,
                  long energy,
                  float invtemp,
                  int nsteps,
                  NUMPY_INT_TYPE_long[:] bead_selector,
                  int passed_seed,
                  int hardwall):
              
    """
    Some explanation is in order re: what the input variables here are

    grid - the main lattice grid

    type_grid - mirrors the lattice grid but the integers represent residue types not chain IDs

    interaction_table - lookup table for the short range interactions of 2 beads
    
    interaction_table - lookup table for the long range interactions of 2 beads

    angle_lookup - lookup table for angle energies 

    energy - current energy

    invtemp - current inverse temperature

    nsteps - number of steps to perform

    passed_seed - a random seed generated by the main program, ensures reproducibility

    Parameters
    ----------
    grid : (XDIM, YDIM) NUMPY_INT_TYPE (int32) memoryview
        Occupancy grid holding the chainID at each occupied site and 0 where
        empty. Updated in place as moves are accepted.
    type_grid : (XDIM, YDIM) NUMPY_INT_TYPE (int32) memoryview
        Residue intcode at each occupied site, 0 for solvent. Updated in place
        alongside grid.
    idx_to_bead : (num_beads, 7) NUMPY_INT_TYPE_long (int64) memoryview
        Per-bead state table, laid out as in mega_crank.mega_crank but without
        the z column: 0 bead_flag, 1 LR flag, 2 intcode, 3 skip-angles flag,
        4 chainID, 5 x position, 6 y position. Columns 5 and 6 are updated in
        place as moves are accepted.
    interaction_table : (n_types, n_types) NUMPY_INT_TYPE (int32) memoryview
        Short-range pair energies indexed by the two residue intcodes, with row
        and column 0 holding the solvent interactions.
    LR_interaction_table : (n_types, n_types) NUMPY_INT_TYPE (int32) memoryview
        Long-range pair energies, same indexing.
    SLR_interaction_table : (n_types, n_types) NUMPY_INT_TYPE (int32) memoryview
        Super-long-range pair energies, same indexing.
    angle_lookup : (n_types, 3, 3, 3, 3) NUMPY_INT_TYPE (int32) memoryview
        Precomputed angle penalties indexed by the middle bead's intcode and the
        two unit bond vectors, each component shifted from -1/0/+1 into 0/1/2.
    energy : long
        Total system energy on entry. Carried through the sweep and returned.
    invtemp : float (C float)
        Inverse temperature (1 / kT) used in the Metropolis criterion.
    nsteps : int (C int)
        Number of single-bead moves to attempt. A value <= 0 is a no-op.
    bead_selector : (>= nsteps,) NUMPY_INT_TYPE_long (int64) memoryview
        Pre-drawn bead indices, one per substep, indexed by the loop counter.
    passed_seed : int (C int)
        Seed for the PRNG, which lives in mega_crank and is shared with the 3D
        kernel. Set once at the start of the sweep.
    hardwall : int (C int)
        1 if the box has hard walls, in which case any proposal whose bond would
        straddle the boundary is discarded and interactions across the boundary
        are treated as solvent; 0 for fully periodic.

    Returns
    -------
    tuple of (long, int)
        (energy, accepted_moves) - the total system energy after the sweep and
        the number of proposals accepted.
    """
    # set randomseed (shared splitmix64 state lives in mega_crank)
    mega_crank.seed_C_rand(passed_seed)
    # a non-positive substep count is a no-op; without this guard a negative
    # nsteps compared against an unsigned loop counter would wrap to ~2^32
    # iterations and read bead_selector far out of bounds
    if nsteps <= 0:
        return (energy, 0)

    
    cdef int i, bead_index;
    cdef int accepted_moves;
    cdef int XDIM, YDIM;
    cdef int num_beads;
    cdef int bead_flag, move_success
    cdef int old_x, old_y
    cdef int lr_vs_sr, bead_id
    cdef long delta_energy, delta_angle_energy

    accepted_moves = 0

    cdef cnp.ndarray[NUMPY_INT_TYPE, ndim=2] position_triptic = np.zeros([3, 2], dtype=NUMPY_INT_TYPE_PYTHON)    
    cdef cnp.ndarray[NUMPY_INT_TYPE, ndim=2] three_position_holder = np.zeros([3, 2], dtype=NUMPY_INT_TYPE_PYTHON)    
    cdef cnp.ndarray[NUMPY_INT_TYPE, ndim=2] two_position_holder = np.zeros([2, 2], dtype=NUMPY_INT_TYPE_PYTHON)
    
    cdef cnp.ndarray[NUMPY_INT_TYPE, ndim=1] old_position = np.zeros([2], dtype = NUMPY_INT_TYPE_PYTHON)
    cdef cnp.ndarray[NUMPY_INT_TYPE, ndim=1] anchor_bead = np.zeros([2], dtype = NUMPY_INT_TYPE_PYTHON)    
    cdef cnp.ndarray[NUMPY_INT_TYPE, ndim=1] new_position = np.zeros([2], dtype = NUMPY_INT_TYPE_PYTHON)
    

    XDIM = grid.shape[0]
    YDIM = grid.shape[1]

    # get the number of beads
    
    # angle short-circuit
    for i in range(nsteps):

        # select random a bead from the preallocated bead_selector      
        bead_index   = bead_selector[i]

        # get position
        bead_flag = idx_to_bead[bead_index,0]
        old_x = idx_to_bead[bead_index,5]
        old_y = idx_to_bead[bead_index,6]
        lr_vs_sr = idx_to_bead[bead_index,1]
        bead_id = idx_to_bead[bead_index,4]

        old_position[0] = old_x
        old_position[1] = old_y

        # ------------------------------------------------------------
        # if single bead (beadflag == 0)
        if bead_flag == 0:
            move_success = single_bead_crank_2D(old_position, grid, XDIM, YDIM, new_position)

            # HARDWALL monomer guard - see the 3D reference kernel (mega_crank.pyx)
            if hardwall == 1 and move_success == 1:
                two_position_holder[0] = new_position
                two_position_holder[1] = old_position
                if do_positions_stradle_pbc_boundary_2D(two_position_holder, 2) == 1:
                    continue

        # ------------------------------------------------------------
        # if N-terminal bead (beadflag == 1)
        elif bead_flag == 1:
            anchor_bead[0] = idx_to_bead[bead_index+1,5]
            anchor_bead[1] = idx_to_bead[bead_index+1,6]

            move_success = single_bead_crank_2D(anchor_bead, grid, XDIM, YDIM, new_position)
            
            if hardwall == 1:
                two_position_holder[0] = new_position
                two_position_holder[1] = anchor_bead
                if do_positions_stradle_pbc_boundary_2D(two_position_holder, 2) == 1:
                    continue

        # ------------------------------------------------------------
        # if C-terminal bead (beadflag == 3)
        elif bead_flag == 3:

            anchor_bead[0] = idx_to_bead[bead_index-1,5]
            anchor_bead[1] = idx_to_bead[bead_index-1,6]
            move_success = single_bead_crank_2D(anchor_bead, grid, XDIM, YDIM, new_position)

            if hardwall == 1:
                two_position_holder[0] = anchor_bead
                two_position_holder[1] = new_position

                if do_positions_stradle_pbc_boundary_2D(two_position_holder,2) == 1:
                    continue

        # ------------------------------------------------------------
        # we're somewhere inside the chain, and beadflag is 2,4,5, or 6
        else:
            position_triptic[0,0] = idx_to_bead[bead_index-1,5]
            position_triptic[0,1] = idx_to_bead[bead_index-1,6]
            
            position_triptic[1,0] = old_x
            position_triptic[1,1] = old_y

            position_triptic[2,0] = idx_to_bead[bead_index+1,5]
            position_triptic[2,1] = idx_to_bead[bead_index+1,6]


            
            # normal crank move!
            move_success = crank_it_2D(position_triptic, grid, XDIM, YDIM, new_position)

            if hardwall == 1:
                three_position_holder[0] = position_triptic[0]
                three_position_holder[1] = new_position
                three_position_holder[2] = position_triptic[2]
                
                if do_positions_stradle_pbc_boundary_2D(three_position_holder,3) == 1:
                    continue
        
        # if hardsphere success
        if move_success == 1:

            delta_energy = get_energy_change_2D(grid, type_grid, old_position, new_position, lr_vs_sr,  interaction_table, LR_interaction_table, SLR_interaction_table, XDIM, YDIM, hardwall)
            delta_angle_energy = get_angle_energy_change_2D(bead_index, idx_to_bead, new_position, angle_lookup)
            
            if mega_crank.accept_or_reject_ext(invtemp, energy, energy+delta_energy+delta_angle_energy) == 1:
                                
                # delete from main grid and insert into new position                                            
                grid[old_x, old_y] = 0

                # inert the bead to its new position
                grid[new_position[0], new_position[1]] = bead_id
                
                # set new type grid to old type grid value
                type_grid[new_position[0], new_position[1]] = type_grid[old_x, old_y]

                # zero out old position on type grid                
                type_grid[old_x, old_y] = 0

                # IMPORTANT!!! This change *MUST* be done last as the old_position is actually a reference
                # to chain_position[bead_index] so changing it BEFORE hand changes the old_position variable and
                # breaks everything
                idx_to_bead[bead_index,5] = new_position[0]
                idx_to_bead[bead_index,6] = new_position[1]
                
                
                energy = energy + delta_energy + delta_angle_energy
                accepted_moves = accepted_moves + 1
                

    return (energy, accepted_moves)



# --------------------------------------------------------------------------------------------------------
#
# 
cdef int crank_it_2D(NUMPY_INT_TYPE[:,:] position_triptic,
                     NUMPY_INT_TYPE[:,:] grid,
                     int XDIM,
                     int YDIM,
                     NUMPY_INT_TYPE[:] new_position):
    """
    Perform crankshaft move!

    2D counterpart of mega_crank.crank_it. The i-1 and i+1 positions constrain
    where the middle bead can go: both are first lifted out of periodic space (a
    separation of more than 2 along an axis can only mean the pair straddles a
    boundary), the allowed box is intersected there, and the drawn position is
    wrapped back into the box.

    Unlike the 3D version this writes through an output memoryview rather than
    allocating, and reports success through the return value.

    Parameters
    ----------
    position_triptic : (3, 2) NUMPY_INT_TYPE (int32) memoryview
        The x,y positions of the -1, 0 and 1 positions of the chain, one per
        row, where row 1 is the bead to be moved and rows 0 and 2 are the
        flanking beads that constrain it.
    grid : (XDIM, YDIM) NUMPY_INT_TYPE (int32) memoryview
        Occupancy grid, read to reject hard-sphere clashes.
    XDIM : int (C int)
        Box size along x.
    YDIM : int (C int)
        Box size along y.
    new_position : (2,) NUMPY_INT_TYPE (int32) memoryview
        Output buffer. Written with the wrapped proposed position on success,
        and with [-1, 0] on failure.

    Returns
    -------
    int (C int)
        1 if a position was proposed, 0 if the target site was occupied.
    """
   
    cdef int N_side_x, N_side_y, C_side_x, C_side_y;
    cdef int x_min, x_max, y_min, y_max
    # extract out x and y positions and perform a series of PBC corrections as needed
    N_side_x = position_triptic[0,0]
    N_side_y = position_triptic[0,1]

    C_side_x = position_triptic[2,0]
    C_side_y = position_triptic[2,1]

    ## Periodicity fix 1
    # move into a non-periodic space just for now
    if abs(N_side_x - C_side_x) > 2:
        if N_side_x > C_side_x:
            C_side_x = C_side_x + XDIM
        else:
            N_side_x = N_side_x + XDIM
        
    if abs(N_side_y - C_side_y) > 2:
        if N_side_y > C_side_y:
            C_side_y = C_side_y + YDIM
        else:
            N_side_y = N_side_y + YDIM

    # get smallest/largest possible new x value
    x_min = int_max(N_side_x-1, C_side_x-1) 
    x_max = int_min(N_side_x+1, C_side_x+1) 

    # get smallest/largest possible new y value
    y_min = int_max(N_side_y-1, C_side_y-1) 
    y_max = int_min(N_side_y+1, C_side_y+1) 
    
    cdef int local_x = pbc_correction((x_min + mega_crank.randint_ext(1, (x_max - x_min + 1)) - 1 ) , XDIM);
    cdef int local_y = pbc_correction((y_min + mega_crank.randint_ext(1, (y_max - y_min + 1)) - 1 ) , YDIM)
    
    if grid[local_x, local_y] > 0:
        # fail (y zeroed to match the fast kernel structurally - see above)
        new_position[0] = -1
        new_position[1] = 0
        return 0

    # hard sphere clash
    else:
        # success        
        new_position[0] = local_x;
        new_position[1] = local_y;
        return 1

