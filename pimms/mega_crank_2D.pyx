def update_position_2D(NUMPY_INT_TYPE[:] old_position, NUMPY_INT_TYPE[:,:]  grid, NUMPY_INT_TYPE x_off, NUMPY_INT_TYPE y_off, NUMPY_INT_TYPE XDIM, NUMPY_INT_TYPE YDIM):
    """
    2D counterpart of mega_crank.update_position: apply a per-axis offset to a
    position, wrap it back into the box, and reject the result if the target site
    is already occupied.

    Nothing is written to the grid here; this only proposes a position.

    Parameters
    ----------
    old_position : (2,) NUMPY_INT_TYPE (int32) memoryview
        Current (x, y) of the bead.
    grid : (XDIM, YDIM) NUMPY_INT_TYPE (int32) memoryview
        Occupancy grid, read to test for a hard-sphere clash. A site holds the
        chainID of whatever occupies it, and 0 when empty.
    x_off : NUMPY_INT_TYPE (int32)
        Displacement along x. Callers pass -1, 0 or +1.
    y_off : NUMPY_INT_TYPE (int32)
        Displacement along y.
    XDIM : NUMPY_INT_TYPE (int32)
        Box size along x, used to wrap the proposed coordinate.
    YDIM : NUMPY_INT_TYPE (int32)
        Box size along y.

    Returns
    -------
    (2,) numpy.ndarray, NUMPY_INT_TYPE (int32)
        The wrapped proposed position, or [-1, 0] if the target site is
        occupied. Callers test element 0 for a negative value.
    """
    
    cdef cnp.ndarray[NUMPY_INT_TYPE, ndim=1] new_position = np.zeros([2], dtype=NUMPY_INT_TYPE_PYTHON)

    cdef int local_x = pbc_correction(old_position[0] + x_off, XDIM)
    cdef int local_y = pbc_correction(old_position[1] + y_off, YDIM)

    if grid[local_x, local_y] > 0:
        # fail. Also zero the y slot so the buffer never carries a stale
        # coordinate from a previous iteration - this makes the reference
        # structurally identical to the fast kernel (which writes out[1] = 0),
        # so the downstream hardwall straddle test sees the same values in both.
        new_position[0] = -1
        new_position[1] = 0
    # hard sphere clash
    else:
        # success        
        new_position[0] = local_x
        new_position[1] = local_y

    return (new_position)


